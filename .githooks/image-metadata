#!/bin/sh
# Fails if any image given has metadata left (EXIF, GPS, XMP, comments): stripping it would change the
# file. The colour profile may stay. Fix: exiftool -all= -tagsfromfile @ -icc_profile -overwrite_original <file>
# Usage: image-metadata <file>...   or, from the pre-commit hook, image-metadata --staged
if ! command -v exiftool >/dev/null 2>&1; then
  echo "image-metadata: exiftool is not installed (brew install exiftool), images can't be checked" >&2
  exit 1
fi
strip() { exiftool -q -q -all= -tagsfromfile @ -icc_profile -o - "$1"; }
bad=0
check() {  # $1: file to read, $2: name to report
  if ! strip "$1" | cmp -s - "$1"; then
    echo "image-metadata: $2 has metadata (EXIF, GPS, XMP or a comment), strip it first:" >&2
    echo "  exiftool -all= -tagsfromfile @ -icc_profile -overwrite_original $2" >&2
    bad=1
  fi
}
if [ "$1" = --staged ]; then
  tmp=$(mktemp -d) && trap 'rm -rf "$tmp"' EXIT
  git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' |
    grep -iE '\.(png|jpe?g|gif|webp|tiff?|heic)$' > "$tmp/list"
  while IFS= read -r f; do
    git show ":$f" > "$tmp/blob" && check "$tmp/blob" "$f"
  done < "$tmp/list"
else
  for f in "$@"; do check "$f" "$f"; done
fi
exit $bad
