#!/usr/bin/env bash
# Reads one secret with hidden input and stores it where the host scripts expect it (never mounted into the sandbox).
# Usage: set-secret openrouter|gmail|webhook
set -euo pipefail
umask 077
case "${1:-}" in
  openrouter) read -rsp "OpenRouter key: " v; echo
              sed -i '/^OPENROUTER_API_KEY=/d' ~/.hermes/.env
              printf '\nOPENROUTER_API_KEY=%s\n' "$v" >> ~/.hermes/.env ;;
  gmail)      read -rsp "Gmail app password: " v; echo
              printf '%s' "${v// /}" > ~/.config/bug-inbox/app-password ;;
  webhook)    read -rsp "Discord webhook URL: " v; echo
              printf '%s' "$v" > ~/.config/agent-notify/webhook ;;
  *) echo "usage: set-secret openrouter|gmail|webhook" >&2; exit 2 ;;
esac
echo "saved"
